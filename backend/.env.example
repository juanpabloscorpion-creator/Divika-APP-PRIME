PORT=3001
# Dirección del front. Varias separadas por coma (ej. https://divika.vercel.app,http://localhost:3000)
FRONTEND_URL=http://localhost:3000

# PostgreSQL (necesita PostGIS; Neon y Render lo traen). Ejemplos:
#   local: postgres://divika:divika@localhost:5432/divika
#   Neon:  postgres://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/divika?sslmode=require
DATABASE_URL=postgres://divika:divika@localhost:5432/divika
# DB_SSL=true   # solo si tu proveedor pide SSL y la URL no trae sslmode

# Obligatorio: la app no arranca sin JWT_SECRET. En producción usa un valor aleatorio propio
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# URL pública de este backend; arma el enlace de las fotos guardadas en disco
PUBLIC_URL=http://localhost:3001

# Fotos en la nube (recomendado en Render, que borra el disco al reiniciar).
# Cloudinary → Dashboard → "API environment variable"
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Zona horaria de los negocios (horas de reserva)
# TZ_NEGOCIOS=America/Mexico_City

# false = no crear los 48 negocios de ejemplo en una base vacía
# SEMBRAR_EJEMPLOS=true
