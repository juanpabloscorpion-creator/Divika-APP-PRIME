// Divika - Esquema completo: diagrama del equipo de backend (docs/divika.dbml) + tablas extra
// Tablas extra en morado. Para verlo: pegar en https://dbdiagram.io/d

Enum rol_usuario {
  consumidor
  vendedor
  admin
}

Enum estatus_usuario {
  activo
  suspendido
  eliminado
}

Enum otp_channel {
  mensaje
  whatsapp
  voz
  correo
}

Enum estatus_negocio {
  draft
  pending
  verificado
  rechazado
  suspendido
}

Enum origen_negocio {
  registro_propio
  precargado
  admin
}

Enum tipo_foto {
  logo
  cubrir
  galeria
}

Enum metodo_verificacion {
  sms
  llamada
  documento
}

Enum estado_solicitud {
  pending
  aprobado
  rechazado
  expirado
}

Enum tipo_documento {
  constancia_fiscal
  comprobante_domicilio
}

Enum estado_revision {
  pendiente
  publicado
  rechazado
}

Enum tipo_contacto {
  llamada
  whatsapp
  web
}

Enum plataforma {
  ios
  android
  web
}

Table usuarios {
  id uuid [pk, default: `gen_random_uuid()`]
  n_completo varchar(80) [not null]
  email varchar(254) [not null, unique]
  contraseña text [note: 'NULL si usa SSO / passwordless']
  telefono varchar(16)
  verificacion_tel timestamptz
  cod_postal varchar(10)
  ubicacion geography [note: 'Point 4326']
  rol rol_usuario [not null, default: 'consumidor']
  estatus estatus_usuario [not null, default: 'activo']
  creada timestamptz [not null, default: `now()`]
  actualizada timestamptz [not null, default: `now()`]
  eliminada timestamptz
  indexes {
    telefono
  }
}

Table autenticacion {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > usuarios.id]
  provider varchar(20) [not null, note: 'google | apple | facebook']
  provider_user_id varchar(255) [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (provider, provider_user_id) [unique]
  }
}

Table otp_codes {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [ref: > usuarios.id]
  destination varchar(254) [not null, note: 'teléfono E.164 o email']
  code_hash text [not null]
  channel otp_channel [not null]
  purpose varchar(30) [not null, note: 'login | phone_verify | password_reset']
  attempts smallint [not null, default: 0]
  expires_at timestamptz [not null]
  consumed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (destination, created_at)
  }
}

Table refresh_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > usuarios.id]
  token_hash text [not null, unique]
  user_agent text
  ip inet
  expires_at timestamptz [not null]
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table device_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > usuarios.id]
  token text [not null, unique, note: 'FCM / APNs / Web Push']
  platform plataforma [not null]
  created_at timestamptz [not null, default: `now()`]
  last_used_at timestamptz
  indexes {
    user_id
  }
}

Table categories {
  id uuid [pk, default: `gen_random_uuid()`]
  parent_id uuid [ref: > categories.id]
  name varchar(80) [not null]
  slug varchar(100) [not null, unique]
  created_at timestamptz [not null, default: `now()`]
}

Table businesses {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_id uuid [ref: > usuarios.id, note: 'NULL = precargado sin dueño']
  trade_name varchar(100) [not null]
  slug varchar(120) [not null, unique]
  legal_name varchar(200)
  tax_id varchar(13) [note: 'RFC, opcional al registrar']
  short_description varchar(250)
  phone_public varchar(16)
  whatsapp varchar(16)
  website text
  logo_url text
  cover_url text
  status estatus_negocio [not null, default: 'draft']
  source origen_negocio [not null, default: 'registro_propio']
  plan varchar(20) [not null, default: 'free']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  indexes {
    owner_id
    status
  }
}

Table business_addresses {
  business_id uuid [pk, ref: - businesses.id]
  street varchar(150) [not null]
  ext_number varchar(20)
  int_number varchar(20)
  neighborhood varchar(100)
  postal_code varchar(10) [not null]
  city varchar(100) [not null]
  state varchar(100) [not null]
  country char(2) [not null, default: 'MX']
  location geography [not null, note: 'Point 4326, índice GIST']
  indexes {
    postal_code
  }
}

Table business_categories {
  business_id uuid [not null, ref: > businesses.id]
  category_id uuid [not null, ref: > categories.id]
  is_primary boolean [not null, default: false]
  indexes {
    (business_id, category_id) [pk]
  }
}

Table business_hours {
  id uuid [pk, default: `gen_random_uuid()`]
  business_id uuid [not null, ref: > businesses.id]
  weekday smallint [not null, note: '0=domingo ... 6=sábado']
  open_time time
  close_time time
  is_closed boolean [not null, default: false]
  indexes {
    (business_id, weekday)
  }
}

Table business_photos {
  id uuid [pk, default: `gen_random_uuid()`]
  business_id uuid [not null, ref: > businesses.id]
  url text [not null]
  type tipo_foto [not null, default: 'galeria']
  position smallint [not null, default: 0]
  mime_type varchar(30)
  size_bytes integer [note: 'máx 5 MB']
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (business_id, type, position)
  }
}

Table verification_requests {
  id uuid [pk, default: `gen_random_uuid()`]
  business_id uuid [not null, ref: > businesses.id]
  requested_by uuid [ref: > usuarios.id]
  method metodo_verificacion [not null]
  status estado_solicitud [not null, default: 'pending']
  pin_hash text
  attempts smallint [not null, default: 0]
  expires_at timestamptz
  reviewed_by uuid [ref: > usuarios.id]
  reviewed_at timestamptz
  reject_reason text
  created_at timestamptz [not null, default: `now()`]
  indexes {
    business_id
    status
  }
}

Table verification_documents {
  id uuid [pk, default: `gen_random_uuid()`]
  request_id uuid [not null, ref: > verification_requests.id]
  doc_type tipo_documento [not null]
  file_url text [not null]
  issued_at date [not null, note: 'máx 3 meses de antigüedad']
  created_at timestamptz [not null, default: `now()`]
}

Table business_claims {
  id uuid [pk, default: `gen_random_uuid()`]
  business_id uuid [not null, ref: > businesses.id]
  claimant_user_id uuid [not null, ref: > usuarios.id]
  verification_request_id uuid [ref: > verification_requests.id]
  status estado_solicitud [not null, default: 'pending']
  created_at timestamptz [not null, default: `now()`]
  resolved_at timestamptz
}

Table favorites {
  user_id uuid [not null, ref: > usuarios.id]
  business_id uuid [not null, ref: > businesses.id]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, business_id) [pk]
  }
}

Table reviews {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > usuarios.id]
  business_id uuid [not null, ref: > businesses.id]
  rating smallint [not null, note: '1 a 5']
  comment text
  status estado_revision [not null, default: 'pendiente']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, business_id) [unique]
    (business_id, status)
  }
}

Table contact_events {
  id bigserial [pk]
  user_id uuid [ref: > usuarios.id]
  business_id uuid [not null, ref: > businesses.id]
  type tipo_contacto [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (business_id, created_at)
  }
}

Table audit_log {
  id bigserial [pk]
  actor_id uuid [ref: > usuarios.id]
  action varchar(60) [not null]
  entity varchar(60) [not null]
  entity_id uuid
  diff jsonb
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (entity, entity_id)
  }
}


// =====================================================================
// TABLAS EXTRA (no están en el diagrama original). Las agrega el backend
// para funciones que el front ya usa. Mismo estilo: uuid, snake_case.
// =====================================================================

Enum modalidad_servicio {
  local
  domicilio
  ambos
}

Enum estado_cita {
  solicitada
  confirmada
  propuesta
  rechazada
  cancelada
}

Table user_profiles [headercolor: #4B3F8F] {
  user_id uuid [pk, ref: - usuarios.id]
  birth_date date
  city varchar(100)
  avatar_url text
  preferences jsonb [note: 'notificaciones y privacidad']
  Note: 'Datos de "Editar perfil" que no caben en usuarios'
}

Table business_details [headercolor: #4B3F8F] {
  business_id uuid [pk, ref: - businesses.id]
  description varchar(600) [note: 'descripción larga del perfil']
  public_email varchar(254)
  payment_methods "varchar[]" [note: 'efectivo | transferencia | tarjeta (informativo)']
  payment_instructions text [note: 'privado salvo show_payment_on_profile']
  show_payment_on_profile boolean [not null, default: true]
  home_service boolean [not null, default: false]
  address_references varchar(300)
  location_confirmed boolean [not null, default: false, note: 'false = location es el centro de la ciudad']
  coverage_radius_km smallint
  coverage_zones "varchar[]"
  booking_rules jsonb [note: '{ duracionBase, intervaloMin, anticipacionHoras, maxDias }']
  blocked_dates jsonb [note: '[{ desde, hasta, motivo }]']
  paused_at timestamptz [note: 'el dueño pausó su perfil']
  updated_at timestamptz [not null, default: `now()`]
}

Table services [headercolor: #4B3F8F] {
  id uuid [pk, default: `gen_random_uuid()`]
  business_id uuid [not null, ref: > businesses.id]
  name varchar(80) [not null]
  description varchar(400)
  price "numeric(10,2)" [note: 'NULL = a consultar']
  duration_min smallint [not null, default: 60]
  category varchar(60)
  modality modalidad_servicio [not null, default: 'local']
  travel_fee "numeric(10,2)"
  instructions varchar(400)
  photo_url text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
}

Table appointments [headercolor: #4B3F8F] {
  id uuid [pk, default: `gen_random_uuid()`]
  business_id uuid [not null, ref: > businesses.id]
  client_id uuid [not null, ref: > usuarios.id]
  service_id uuid [ref: > services.id]
  date date [not null]
  start_time time [not null]
  party_size smallint [not null, default: 1]
  notes varchar(300)
  payment_method varchar(20) [note: 'informativo']
  status estado_cita [not null, default: 'solicitada']
  proposed_date date
  proposed_time time
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (business_id, date)
    client_id
  }
}

Table messages [headercolor: #4B3F8F] {
  id uuid [pk, default: `gen_random_uuid()`]
  business_id uuid [not null, ref: > businesses.id]
  client_id uuid [not null, ref: > usuarios.id]
  sender varchar(10) [not null, note: 'cliente | negocio']
  body text [not null]
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (business_id, client_id, created_at)
  }
}

Table notifications [headercolor: #4B3F8F] {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > usuarios.id]
  type varchar(20) [not null, note: 'cita | mensaje | resena']
  title varchar(160) [not null]
  detail varchar(160)
  link varchar(200) [note: 'ruta del front']
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, created_at)
  }
}

Table review_replies [headercolor: #4B3F8F] {
  review_id uuid [pk, ref: - reviews.id]
  body text [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table business_views [headercolor: #4B3F8F] {
  id bigserial [pk]
  business_id uuid [not null, ref: > businesses.id]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (business_id, created_at)
  }
}

Table support_reports [headercolor: #4B3F8F] {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [ref: > usuarios.id]
  type varchar(30) [not null]
  description varchar(1000) [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table provider_leads [headercolor: #4B3F8F] {
  id uuid [pk, default: `gen_random_uuid()`]
  business_name varchar(120) [not null]
  service varchar(120) [not null]
  phone varchar(30) [not null]
  city varchar(80) [not null]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Formulario "Únete gratis" de la landing (sin cuenta)'
}

// ===== Grupos (dbdiagram los dibuja como recuadros) =====
TableGroup cuentas [color: #2B2D6C] {
  usuarios
  autenticacion
  otp_codes
  refresh_tokens
  device_tokens
  user_profiles
}
TableGroup negocios [color: #1F5F9E] {
  categories
  businesses
  business_addresses
  business_categories
  business_hours
  business_photos
  business_details
  services
}
TableGroup verificacion [color: #ED5034] {
  verification_requests
  verification_documents
  business_claims
}
TableGroup actividad [color: #38C96A] {
  favorites
  reviews
  review_replies
  contact_events
  business_views
  audit_log
}
TableGroup agenda_y_mensajes [color: #4B3F8F] {
  appointments
  messages
  notifications
  support_reports
  provider_leads
}
